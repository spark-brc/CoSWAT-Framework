# --- Textual App ---
class FolderItem(Static):
    '''
    Widget to display a folder item.

    folderName : name of the folder to display
    '''
    def __init__(self, folderName, **kwargs):
        super().__init__(f"• {folderName}", **kwargs)
        self.folderName = folderName

class StatusApp(App):
    '''
    The main application class.
    
    directoriesToWatch : list of directory names to monitor
    '''
    CSS_PATH = "style.css"

    def __init__(self, directoriesToWatch, interval=5, **kwargs):
        super().__init__(**kwargs)
        self.directoriesToWatch = directoriesToWatch
        self.folderStatus = {}
        self.updateFolderListAndStatuses()
        self.updateInterval = interval  # seconds between updates

    def compose(self) -> ComposeResult:
        '''
        Create the initial layout with persistent columns.

        returns : ComposeResult generator for layout
        '''
        yield Header()
        with Container(id="main_container"):
            for status in allStatuses:
                with Container(id=f"{statusToId(status)}_column", classes="column"):
                    yield Static(f"[b]{status}[/b]", id=f"{statusToId(status)}_header", classes="header-cell")

    def on_mount(self) -> None:
        '''
        Set up periodic refresh every other second.
        '''
        self.set_interval(self.updateInterval, self.updateAndRebuild)

    def updateFolderListAndStatuses(self):
        '''
        Update the folder statuses, including all watched directories.
        '''
        self.folderStatus = {}
        for dirName in self.directoriesToWatch:
            modelFolderPath = os.path.join(modelDir, dirName)
            self.folderStatus[dirName] = determineFolderStatus(modelFolderPath)

    def updateAndRebuild(self):
        '''
        Update folder statuses and refresh column contents.
        '''
        self.updateFolderListAndStatuses()
        for status in allStatuses:
            column = self.query_one(f"#{statusToId(status)}_column")
            # Remove all children except the header
            headerId = f"{statusToId(status)}_header"
            for child in list(column.children):
                if child.id != headerId:
                    child.remove()
            # Add new contents
            foldersWithStatus = [name for name, s in self.folderStatus.items() if s == status]
            if not foldersWithStatus:
                column.mount(Static(f"• No {status.lower()} folders", classes="empty-message"))
            else:
                for folder in foldersWithStatus:
                    column.mount(FolderItem(folder, classes="list-item"))
        self.refresh()

