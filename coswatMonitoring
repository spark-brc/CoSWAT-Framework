# --- Define file paths that indicate specific status ---
statusIndicators = {
    "Delineating": "/Watershed/Rasters/DEM/dem-aster-ESRI-54003_burned.tif",
    "Flood Plain": "/Watershed/Rasters/Landscape/Flood/creatingFloodPlain",
    "HRUs Created": "/Watershed/Text/HruLanduseSoilSlopeRepSwat.txt",
    "Editor Created": "/DatabaseBackups/",
    "Finished Editor": ["/Scenarios/Default/TxtInOut/hru-data.hru", "/Scenarios/Default/TxtInOut/file.cio"],
    "Running": "/Scenarios/Default/TxtInOut/basin_wb_aa.txt",
    "Finished Running": "/Scenarios/Default/TxtInOut/success.fin"
}

# --- List of all statuses in order ---
allStatuses = ["Pending", "Initialised", "Delineating", "Flood Plain", "HRUs Created", 
                "Editor Created", "Finished Editor", "Running", "Finished Running"]

# --- Helper function to create valid IDs from status names ---
def statusToId(status):
    '''
    Convert a status name to a valid ID by replacing spaces with underscores.

    status : status name string
    '''
    return status.lower().replace(" ", "_")

# --- Helper function to determine a folder's status ---
def determineFolderStatus(folderPath):
    '''
    Check a folder and determine its current status based on file indicators.

    folderPath : path to the folder to check
    '''
    if not os.path.exists(folderPath):
        return "Pending"
    # Start with initialized status
    highestStatus = "Initialised"
    # Check for all indicator files to determine the highest status
    for status, indicators in statusIndicators.items():
        if isinstance(indicators, list):
            # All files in the list must exist
            if all(os.path.exists(os.path.join(folderPath, ind.lstrip('/'))) for ind in indicators):
                highestStatus = status
        else:
            # Single file indicator
            if os.path.exists(os.path.join(folderPath, indicators.lstrip('/'))):
                highestStatus = status
    return highestStatus

# --- Path configuration ---
refreshInterval = 30

coswatDir   = '/drive/ws/github/CoSWAT-Framework'
